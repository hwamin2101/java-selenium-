<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Week1-Day10-11-TestNG-XML-Suite"
       parallel="tests"
       thread-count="3">

    <!-- TEST 1: Calculator SMOKE (Groups) -->
    <test name="Calculator Smoke Tests">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>

        <classes>
            <class name="session1.exercise2_1.tests.CalculatorTest"/>
        </classes>
    </test>

    <!-- TEST 2: Calculator REGRESSION (Groups) -->
    <test name="Calculator Regression Tests">
        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>

        <classes>
            <class name="session1.exercise2_1.tests.CalculatorTest"/>
        </classes>
    </test>

    <!-- TEST 3: Calculator SPECIFIC METHODS -->
    <test name="Calculator Edge Tests">
        <groups>
            <run>
                <include name="edge"/>
            </run>
        </groups>

        <classes>
            <class name="session1.exercise2_1.tests.CalculatorTest"/>
        </classes>
    </test>


    <!-- TEST 4: Login UI - Browser Chrome -->
    <test name="Login UI - Chrome">
        <parameter name="browser" value="chrome"/>

        <classes>
            <class name="session1.exercise1_3.tests.LoginTest"/>
        </classes>
    </test>

    <!-- TEST 5: Login UI - Parallel -->
    <test name="Login UI - Chrome Parallel">
        <parameter name="browser" value="chrome"/>

        <classes>
            <class name="session1.exercise1_3.tests.LoginTest"/>
        </classes>
    </test>

</suite>
